# Database (Neon pooler endpoint)
DATABASE_URL=postgresql://user:pass@host.neon.tech/dbname?sslmode=require

# Auth
AUTH_SECRET=                          # openssl rand -base64 32
AUTH_GOOGLE_ID=                       # Google OAuth Client ID
AUTH_GOOGLE_SECRET=                   # Google OAuth Client Secret
TOKEN_ENC_KEY=                        # base64 32-byte key for OAuth token encryption at rest (node -e "console.log(require('crypto').randomBytes(32).toString('base64'))")

# Cache + rate limiting
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Web Push (generate with: npx web-push generate-vapid-keys)
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_EMAIL=you@example.com

# Background jobs
TRIGGER_API_KEY=

# LLM
ANTHROPIC_API_KEY=sk-ant-...

# Error monitoring
SENTRY_DSN=
SENTRY_AUTH_TOKEN=

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Service implementations (change to swap providers)
CALENDAR_SERVICE_IMPL=google-calendar
NOTIFICATION_SERVICE_IMPL=web-push

# Stripe (https://dashboard.stripe.com/apikeys)
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...           # from: stripe listen --forward-to localhost:3000/api/stripe/webhook
STRIPE_PRICE_ID_STARTER=price_...         # subscription tier price ID
STRIPE_PRICE_ID_GROWTH=price_...          # subscription tier price ID
STRIPE_PRICE_ID_PRO=price_...             # subscription tier price ID
STRIPE_PACK_PRICE_ID_SMALL=price_...      # one-time token pack price ID
STRIPE_PACK_PRICE_ID_MEDIUM=price_...     # one-time token pack price ID
STRIPE_PACK_PRICE_ID_LARGE=price_...      # one-time token pack price ID
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...

# Comped accounts (optional — comma-separated email addresses granted Pro access for free)
COMPED_EMAILS=
